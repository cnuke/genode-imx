assert {[have_board mnt_reform2]}

create_boot_directory
import_from_depot [depot_user]/src/[base_src] \
                  [depot_user]/src/init \
                  [depot_user]/raw/mnt_reform2-devices

build {
	driver/usb_hid
	server/event_dump
	server/report_rom
	driver/platform/imx8mq
	driver/usb_host/imx8m
}

install_config {
config | verbose: yes
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service IO_PORT
  + service PD
  + service RM
  + service CPU
  + service LOG

+ default-route
  + any-service
    + parent
    + any-child

+ default | caps: 100 | ram: 1M

+ start timer
  + provides | + service Timer

+ start platform | caps: 150 | ram: 2M | managing_system: yes
  + binary imx8mq_platform
  + provides | | + service Platform
  + route | + any-service | + parent
  + config
    + policy | label: usb_host -> | info: yes
      + device usb_host_1
      + device usb_phy_1
      + device usb_host_2
      + device usb_phy_2

+ start report_rom | ram: 2M
  + provides
    + service Report
    + service ROM
  + config | verbose: yes
    + default-policy | report: usb_host -> devices
  + route | + any-service | + parent

+ start usb_host | caps: 250 | ram: 40M
  + binary imx8m_usb_host
  + provides | + service Usb
  + config
    + policy | label_prefix: usb_hid | + device | class: 0x3
  + route
    + service ROM | label: dtb | + parent | label: imx8m_usb_host-mnt_reform2.dtb
    + service RM               | + parent
    + service ROM              | + parent
    + service PD               | + parent
    + service CPU              | + parent
    + service LOG              | + parent
    + service Timer            | + child timer
    + service Report           | + child report_rom
    + service Platform         | + child platform

+ start usb_hid | caps: 140 | ram: 11M
  + route
    + service ROM | label: report | + child report_rom
    + service Event               | + child event_dump
    + any-service
      + parent
      + any-child

+ start event_dump
  + provides | + service Event
  + config
  + route
    + any-service
      + parent
      + any-child
-
}

build_boot_image [build_artifacts]

run_genode_until forever
