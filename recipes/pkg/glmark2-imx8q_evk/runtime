runtime | ram: 200M | caps: 1000 | binary: init

+ requires
  + gui
  + timer
  + platform | label: gpu

+ content
  + rom | label: expat.lib.so
  + rom | label: glapi.lib.so
  + rom | label: glmark2
  + rom | label: glmark2_assets.tar
  + rom | label: imx8mq_gpu
  + rom | label: imx8mq_gpu-imx8q_evk.dtb
  + rom | label: jpeg.lib.so
  + rom | label: ld.lib.so
  + rom | label: libc.lib.so
  + rom | label: libdrm.lib.so
  + rom | label: libm.lib.so
  + rom | label: libpng.lib.so
  + rom | label: init
  + rom | label: mesa.lib.so
  + rom | label: mesa_gpu-etnaviv.lib.so
  + rom | label: stdcxx.lib.so
  + rom | label: vfs.lib.so
  + rom | label: zlib.lib.so
  + rom | label: egl.lib.so
  + rom | label: vfs_gpu.lib.so

+ config | ld_verbose: yes
  + parent-provides
    + service ROM
    + service PD
    + service RM
    + service CPU
    + service LOG
    + service Platform
    + service Timer
    + service Gui

  + start imx8mq_gpu | caps: 300 | ram: 76M
    + provides | + service Gpu
    + route
      + service ROM | label: dtb | + parent | label: imx8mq_gpu-imx8q_evk.dtb
      + service Platform         | + parent | label: gpu
      + any-service              | + parent

  + start glmark2 | caps: 500 | ram: 116M
    + config
    | + vfs
    | | + dir dev
    | |   + log
    | |   + gpu
    | | + dir data
    | |   + tar glmark2_assets.tar
    | + libc | stdout: /dev/log | stderr: /dev/log
    | + arg glmark2
    | + arg -b | : :duration=2.0
    | + arg -s | : 800x600
    | + env GALLIUM_HUD | : fps,draw-calls
    + route
      + service Gpu                          | + child imx8mq_gpu
      + service ROM | label: mesa_gpu.lib.so | + parent | label: mesa_gpu-etnaviv.lib.so
      + service ROM | label: libEGL.so       | + parent | label: mesa.lib.so
      + service ROM | label: libGLESv2.so    | + parent | label: mesa.lib.so
      + any-service
        + parent
        + any-child
-
