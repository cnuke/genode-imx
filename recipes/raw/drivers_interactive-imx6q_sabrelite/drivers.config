config
+ parent-provides
  + service IRQ
  + service IO_MEM
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service Timer
  + service Capture
  + service Event

+ start report_rom | caps: 100 | ram: 2M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + default-policy | report: usb -> devices
  + route | + any-service | + parent

+ start platform | caps: 200 | ram: 3M | managing_system: yes
  + binary imx6q_platform
  + provides | + service Platform
  + config
  | + policy | label: usb ->  | info: yes
  |   + device usbotg
  |   + device usbphy1
  |   + device usbphy2
  |   + device usbmisc_imx
  |   + device usbh1
  | + policy | label: pin ->  | info: yes
  |   + device gpio3
  |   + device gpio7
  + route
    + service IRQ    | + parent
    + service IO_MEM | + parent
    + service ROM    | + parent
    + service PD     | + parent
    + service CPU    | + parent
    + service LOG    | + parent

+ start pin | caps: 150 | ram: 2M
  + binary imx_pio
  + provides
    + service Pin_state
    + service Pin_control
    + service IRQ
  + config
    + out usb_otg_vbus | bank: 0 | index: 22 | default: on
    + out usb_h1_vbus  | bank: 1 | index: 12 | default: on
  + route
    + service Platform | + child platform
    + any-service      | + parent

+ start event_filter | caps: 120 | ram: 2M
  + provides | + service Event
  + route
    + service ROM | label: config | + parent | label: event_filter.config
    + service Event               | + parent
    + any-service                 | + parent

+ start usb | caps: 180 | ram: 20M
  + binary imx_usb_host
  + provides | + service Usb
  + config
  | + report | devices: yes
  | + policy | label_prefix: usb_hid
  |   + device | class: 0x3
  + route
    + service ROM | label: dtb | + parent | label: imx_usb_host-imx6q_sabrelite.dtb
    + service Report           | + child report_rom
    + service ROM              | + parent
    + service PD               | + parent
    + service RM               | + parent
    + service CPU              | + parent
    + service LOG              | + parent
    + service Report           | + parent
    + service Timer            | + parent
    + service Platform         | + child platform

+ start usb_hid | caps: 140 | ram: 11M
  + provides | + service Input
  + route
    + service ROM | label: report | + child report_rom
    + service Event               | + child event_filter | label: usb
    + service RM                  | + parent
    + service ROM                 | + parent
    + service PD                  | + parent
    + service CPU                 | + parent
    + service LOG                 | + parent
    + service Timer               | + parent
    + service Usb                 | + child usb
-
