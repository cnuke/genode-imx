config | arch: | info: Debian Installer using ARM VMM

+ common_routes
  + service ROM | label_last: ld.lib.so | + parent
  + service ROM | label_last: init      | + parent
  + service CPU                         | + parent
  + service PD                          | + parent
  + service LOG                         | + parent
  + service Timer                       | + parent

+ start window_layouter | priority: -1 | pkg: window_layouter
  + route
    + service Gui                                   | + child wm
    + service ROM | label: window_list              | + child wm
    + service ROM | label: focus_request            | + child wm
    + service ROM | label: hover                    | + child wm
    + service ROM | label: decorator_margins        | + child wm
    + service Report                                | + child wm
    + service File_system | label_prefix: recall -> | + child recall_fs

+ start themed_decorator | priority: -1 | pkg: themed_decorator
  + route
    + service ROM | label: window_layout | + child wm
    + service ROM | label: pointer       | + child wm
    + service Report                     | + child wm
    + service Gui                        | + child wm

+ start wm | priority: -1 | pkg: wm
  + route
    + service Gui | label: focus             | + parent | label: focus
    + service Gui                            | + parent
    + service Report | label_last: shape     | + parent
    + service Report | label_last: clipboard | + parent
    + service ROM    | label_last: clipboard | + parent

+ start fonts_fs | priority: -2 | pkg: fonts_fs
  + route
    + service ROM | label: config | + parent | label: config -> managed/fonts

+ start recall_fs | priority: -2 | pkg: recall_fs
  + route
    + service File_system | + child default_fs_rw

+ start wm_backdrop | priority: -2 | pkg: sticks_blue_backdrop
  + route | + service Gui | + parent | label: backdrop
  + config
    + libc
    + vfs
      + rom genode_logo.png
      + rom grid.png
      + rom sticks_blue.png
    + fill | color: #223344
    + image | png: sticks_blue.png | alpha: 200 | anchor: bottom_left | scale: zoom
    + image | png: grid.png        | alpha: 200 | tiled: yes
    + image | png: genode_logo.png | alpha: 150 | anchor: bottom_right
                                                | xpos: -20 | ypos: -20

+ start black_hole | priority: -2 | pkg: black_hole
  + route

+ start debian_installer | pkg: skalk/pkg/vmm-debian-installer-arm64/2023-10-23
  + route
    + service Nic         | + child nic_router
    + service File_system | + child recall_fs
    + service Gui         | + child wm
    + service VM          | + parent
    + service RM          | + parent
-
