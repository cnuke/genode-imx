config
+ output
  + chargen
    + remap
    | x key KEY_CAPSLOCK | to: KEY_ESC
    | + key KEY_F11      | to: KEY_RESTART
    | + key KEY_F12      | to: KEY_DASHBOARD
    | + key KEY_LEFTMETA | to: KEY_SCREEN
    | + include | rom: numlock.remap
    | + merge
    |   + input usb
    + mod1
    | + key KEY_LEFTSHIFT
    | + key KEY_RIGHTSHIFT
    + mod2
    | + key KEY_LEFTCTRL
    | + key KEY_RIGHTCTRL
    + mod3
    | + key KEY_RIGHTALT | . AltGr
    + mod4
    | + rom capslock
    + repeat | delay_ms: 230 | rate_ms: 40
    + include | rom: en_us.chargen
    + include | rom: special.chargen
+ policy | label: usb | input: usb
-
