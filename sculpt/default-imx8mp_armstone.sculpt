platform: imx8mp_armstone

# supplemental depot content added to the system image
import: pkg/sculpt_drivers-imx8mp_armstone src/system_rtc src/dummy_rtc

option: download_debug_info black_hole trace_logger recall_fs mixer system_clock

presets: empty nano3d window_manager falkon_web_browser

depot: genodelabs cnuke alex-ab nfeske cproc chelmuth jschlatow ssumpf skalk

build: driver/platform/imx8mp app/sculpt_manager monitor
