config
+ parent-provides
  + service ROM
  + service IRQ
  + service IO_MEM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service Timer
  + service Report
  + service Capture
  + service Event

+ report | child_caps: yes | child_ram: yes | init_caps: yes | init_ram: yes
         | delay_ms: 5000

+ default-route
  + any-service
    + parent
    + any-child

+ default | caps: 100 | ram: 1M

+ service I2c      | + default-policy | + child i2c
+ service Platform | + default-policy | + child platform

+ start report_rom | ram: 2M
  + provides
    + service Report
    + service ROM
  + config | verbose: no
    + policy | label:  rom_reporter -> pci_devices | report: imx8mq_pci_host -> devices
    + policy | label:  rom_filter -> pci_devices   | report: imx8mq_pci_host -> devices

+ start rom_filter | caps: 70
  + provides | + service ROM
  + config | buffer: 32K
  | + input devices
  | + input pci_devices
  | + output | node: devices
  |   + input devices     | skip_toplevel: yes
  |   + input pci_devices | skip_toplevel: yes
  + route
    + service ROM | label: pci_devices | + child report_rom
    + service LOG                      | + parent
    + service PD                       | + parent
    + service CPU                      | + parent
    + service ROM                      | + parent

+ start rom_reporter
  + config | + rom | label: pci_devices
  + route
    + service ROM    | label: pci_devices | + child report_rom
    + service Report | label: pci_devices | + parent | label: pci_devices
    + service LOG                         | + parent
    + service PD                          | + parent
    + service CPU                         | + parent
    + service ROM                         | + parent

+ start platform | caps: 300 | ram: 3M | managing_system: yes
  + binary imx8mq_platform
  + provides | + service Platform
  + config | ld_verbose: yes
  | + report | devices: yes
  |
  | + policy | label_prefix: runtime -> fb | info: yes
  |   + device dcss
  |   + device hdmi
  |   + device mipi_dsi
  |   + device mipi_dsi_phy
  |   + device lcd
  |   + device irqsteer
  |   + device pclk
  |   + device esc
  |   + device dpi
  |
  | + policy | label: imx8mq_pwm ->
  |   + device pwm
  |
  | + policy | label: gpio ->  | info: yes
  |   + device gpio1
  |   + device gpio2
  |   + device gpio3
  |   + device gpio4
  |   + device gpio5
  |
  | + policy | label: i2c ->
  |   + device i2c
  |
  | + policy | label_prefix: runtime -> usb | info: yes
  |   + device usb_host_1
  |   + device usb_phy_1
  |   + device usb_host_2
  |   + device usb_phy_2
  |
  | + policy | label_prefix: runtime -> mmc | info: yes
  |   + device usdhc1
  |   + device usdhc2
  |
  | + policy | label: runtime -> nic | info: yes
  |   + device fec
  |
  | + policy | label: runtime -> gpu | info: yes
  |   + device gpu
  |
  | + policy | label: imx8mq_pci_host -> | info: yes
  |   + device pcie_1
  |   + device pcie_2
  |
  | + policy | label_prefix: runtime -> nvme | info: yes
  |   + pci | class: NVME
  |
  | + policy | label_prefix: runtime -> wifi | info: yes
  |   + pci | class: WIFI
  |
  + route
    + service Report | label: devices | + parent | label: devices
    + service ROM    | label: devices | + child rom_filter
    + any-service                     | + parent

+ start gpio | caps: 150 | ram: 2M
  + binary imx_pio
  + provides
    + service Pin_state
    + service Pin_control
    + service IRQ
  + config
    + out backlight            | bank: 0 | index: 10 | default: on
    + out edp_bridge           | bank: 2 | index: 20 | default: on
    + out pcie0_reset_deassert | bank: 4 | index:  7 | default: on
    + out pcie1_reset_deassert | bank: 2 | index: 23 | default: on
    + policy | label: imx8mq_pci_host -> | pin: pcie0_reset_deassert
  + route
    + service RM       | + parent
    + service ROM      | + parent
    + service PD       | + parent
    + service CPU      | + parent
    + service LOG      | + parent
    + service Platform | + child platform

+ start imx8mq_pci_host
  + route
    + service RM        | + parent
    + service ROM       | + parent
    + service PD        | + parent
    + service CPU       | + parent
    + service LOG       | + parent
    + service Timer     | + parent
    + service Report    | + child report_rom
    + service Platform  | + child platform
    + service Pin_state | + child gpio

+ start i2c | caps: 150 | ram: 2M
  + binary imx8q_evk_i2c
  + provides | + service I2c
  + config | verbose: yes
    + policy | label_prefix: runtime -> fb | bus_address: 0x2c
  + route
    + service RM       | + parent
    + service ROM      | + parent
    + service PD       | + parent
    + service CPU      | + parent
    + service LOG      | + parent
    + service Timer    | + parent
    + service Platform | + child platform

+ start imx8mq_pwm | caps: 100 | ram: 2M
  + config | period: 248 | sample: 250 | clock_source: ipg_highfreq
  + route
    + service RM       | + parent
    + service ROM      | + parent
    + service PD       | + parent
    + service CPU      | + parent
    + service LOG      | + parent
    + service Platform | + child platform
-
